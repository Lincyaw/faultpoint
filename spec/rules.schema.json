{
  "$defs": {
    "Action": {
      "additionalProperties": true,
      "description": "An action kind and the free parameters the plugin that executes it interprets.",
      "properties": {
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Action",
      "type": "object"
    },
    "Rule": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "point": {
          "pattern": "^[^:]+:[^:]+:.+$",
          "title": "Point",
          "type": "string"
        },
        "action": {
          "$ref": "#/$defs/Action"
        },
        "scope": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Scope",
          "type": "object"
        },
        "trigger": {
          "$ref": "#/$defs/Trigger"
        }
      },
      "required": [
        "id",
        "point",
        "action"
      ],
      "title": "Rule",
      "type": "object"
    },
    "Trigger": {
      "additionalProperties": false,
      "properties": {
        "skip": {
          "default": 0,
          "minimum": 0,
          "title": "Skip",
          "type": "integer"
        },
        "limit": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit"
        },
        "probability": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Probability",
          "type": "number"
        }
      },
      "title": "Trigger",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "experiment": {
      "minLength": 1,
      "title": "Experiment",
      "type": "string"
    },
    "rules": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Rule"
      },
      "title": "Rules",
      "type": "array"
    }
  },
  "required": [
    "experiment"
  ],
  "title": "RuleSet",
  "type": "object"
}
